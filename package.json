{
  "name": "automated-documentation-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/install-gitleaks.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "docs:sync": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@b12k/gitleaks": "8.30.1-v.57",
    "fast-xml-parser": "5.11.2",
    "keytar": "^7.9.0",
    "yaml": "2.9.1"
  }
}
